fun compter_jusqua(i32 limite) void
{
    let i32 index = 0;
    while (index < limite) {
        index = index + 1;
		// ou index++;
    }
}

fun is_bigger_than20(i32 value) i8
{
	if (value > 20) {
		return (1);
	} else {
		return (0);
	}
}

