// precedence and left-associativity of + - * / %
fun f1() i32 { return a + b * c; }
fun f2() i32 { return a * b + c; }
fun f3() i32 { return a - b - c; }
fun f4() i32 { return a / b % c * d; }
fun f5() i32 { return a + b * c - d / e; }
fun f6() i32 { return a - b + c - d; }
fun f7() i32 { return a * b * c * d; }
fun f8() i32 { return 1 + 2 * 3 - 4; }
