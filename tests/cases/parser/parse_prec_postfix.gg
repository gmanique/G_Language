// postfix operators (call, index, member) chain left to right
fun f1() i32 { return a.b.c; }
fun f2() i32 { return a[1][2]; }
fun f3() i32 { return f(1)(2); }
fun f4() i32 { return a.b[1].c(2); }
fun f5() i32 { return f(a, g(b), c[1]); }
fun f6() i32 { return f(); }
fun f7() i32 { return a[b[c]]; }
fun f8() i32 { return a.b(c).d; }
fun f9() i32 { return f(1)[2]; }
fun f10() i32 { return a[1 + 2 * 3]; }
fun f11() i32 { return f(a = 1, b == 2); }
fun f12() i32 { return syscall(60, 0); }
fun f13() i32 { return syscall(); }
fun f14() i32 { return f(a)(b)(c); }
fun f15() i32 { return a.b.c.d.e; }
fun f16() i32 { return f(g(h(i()))); }
