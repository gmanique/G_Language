// a chain of ten functions
fun f0(i32 x) i32 { return (f1(x + 1)); }
fun f1(i32 x) i32 { return (f2(x + 1)); }
fun f2(i32 x) i32 { return (f3(x + 1)); }
fun f3(i32 x) i32 { return (f4(x + 1)); }
fun f4(i32 x) i32 { return (f5(x + 1)); }
fun f5(i32 x) i32 { return (f6(x + 1)); }
fun f6(i32 x) i32 { return (f7(x + 1)); }
fun f7(i32 x) i32 { return (f8(x + 1)); }
fun f8(i32 x) i32 { return (f9(x + 1)); }
fun f9(i32 x) i32 { return (x); }
fun main() i32 { return (f0(0)); }
